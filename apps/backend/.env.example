# Local backend development defaults. This file contains no deployable secrets.
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://admin:admin@localhost:5432/postgres?schema=public

# AuthSCH (register a local application at https://auth.sch.bme.hu/console/create)
AUTHSCH_CLIENT_ID=replace-with-local-authsch-client-id
AUTHSCH_CLIENT_SECRET=replace-with-local-authsch-client-secret

# Keep these values distinct. Generate strong, instance-specific secrets in production.
JWT_SECRET=local-jwt-signing-secret-change-me
SESSION_SECRET=local-session-cookie-secret-change-me

# Backend runtime
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001

# Swagger is enabled explicitly for local development only.
ENABLE_SWAGGER=true

# Required: fixed PÉK group ID for this deployment (not a person ID)
AUTHSCH_GROUP_ID=
